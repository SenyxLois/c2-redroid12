on init
    setprop debug.stagefright.ccodec 4

on post-fs-data
    setprop debug.stagefright.ccodec 4
    # c2 allocator needs rw access to dmabuf system heap
    chmod 0666 /dev/dma_heap/system
    symlink /dev/dma_heap/system /dev/dma_heap/system-uncached

service vendor.c2-redroid12 /vendor/bin/hw/android.hardware.media.c2@1.2-service.redroid
    class hal
    user mediacodec
    group camera drmrpc mediadrm gpu
    ioprio rt 4
    capabilities SYS_NICE
    writepid /dev/cpuset/foreground/tasks
